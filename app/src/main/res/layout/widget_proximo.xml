<?xml version="1.0" encoding="utf-8"?>
<!-- Widget no estilo folhinha: número do dia em terracota e o próximo compromisso ao lado.
     Os textos fixos são o exemplo da prévia; desenharWidget() troca pelos reais. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/dia"
        android:text="14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="76dp"
        android:fontFamily="@font/lexend"
        android:includeFontPadding="false"
        android:textColor="@color/terracota"
        android:textSize="72sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/quando"
        android:text="Hoje, às 14h30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend"
            android:textColor="#6B5D52"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/titulo"
        android:text="Consulta no cardiologista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/lexend"
            android:maxLines="2"
            android:textColor="#2B2420"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aviso"
        android:text="Toca às 13h30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawableStart="@drawable/ic_sino_terracota"
            android:drawablePadding="6dp"
            android:fontFamily="@font/lexend"
            android:gravity="center_vertical"
            android:textColor="@color/terracota"
            android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>
